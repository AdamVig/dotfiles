#!/usr/bin/env bash

set -euo pipefail

branch=
args=()

# If first argument is empty or looks like a flag, use the base branch
if [ -z "${1-}" ] || [[ ${1-} == -* ]]; then
	branch="$(get-base-branch)"
	args+=("${@:1}")
else
	branch="${1-}"
	args+=("${@:2}")
fi

git log "$branch".. --oneline --pretty=who-when-what "${args[@]}" --
