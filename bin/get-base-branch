#!/usr/bin/env bash

set -euo pipefail

# Get the ref the current branch is based on: the nearest unmerged branch below it in a gh stack, otherwise the
# default branch of the `upstream` remote if there is one (i.e. a fork), or of `origin` (e.g. `origin/main`).

remote=origin
if git remote get-url upstream &>/dev/null; then
	remote=upstream
fi

# gh-stack's local state, read directly because `gh stack view --json` costs an API request per PR in the stack
# Path: https://github.com/github/gh-stack/blob/v0.2.1/internal/stack/stack.go#L16
# Format: https://github.com/github/gh-stack/blob/v0.2.1/internal/stack/schema.json
state_file="$(git rev-parse --git-common-dir)/gh-stack"
# Prints the nearest unmerged branch below `$branch`, or the stack's trunk on `$remote`; nothing if not in a stack
# shellcheck disable=SC2016
stack_parent_filter='
	if .schemaVersion != 1 then
		error("unsupported gh-stack state schema version \(.schemaVersion) in \($file); update get-base-branch")
	end
	| first(
		.stacks[]
		| (.branches | map(.branch) | index($branch)) as $index
		| select($index)
		| ([ .branches[:$index][] | select(.pullRequest.merged | not) | .branch ] | last) // "\($remote)/\(.trunk.branch)"
	)
'

parent=''
# Detached HEAD has no branch, so it can't be in a stack
if [ -f "$state_file" ] && branch="$(git symbolic-ref --quiet --short HEAD)"; then
	parent="$(jq --raw-output --arg branch "$branch" --arg remote "$remote" --arg file "$state_file" \
		"$stack_parent_filter" "$state_file")"
fi

if [ -n "$parent" ]; then
	echo "$parent"
else
	git symbolic-ref --short "refs/remotes/$remote/HEAD"
fi
