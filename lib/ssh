#!/usr/bin/env bash

# shellcheck source=./lib/helpers
source "${BASH_SOURCE[0]%/*}/helpers"

log() {
	log_with_component ssh "$@"
}

log_start 'configuring SSH'

mkdir --parents "$HOME"/.ssh
chmod 700 "$HOME"/.ssh
ssh_config_path="$HOME"/.ssh/config
touch "$ssh_config_path"
chmod 600 "$ssh_config_path"

add_ssh_config() {
	if ! grep --quiet --fixed-strings "$1" "$ssh_config_path"; then
		echo "$1" >>"$ssh_config_path"
	fi
}

add_ssh_config 'AddKeysToAgent yes'
# `IgnoreUnknown` lets Linux SSH silently skip the macOS-only `UseKeychain`
add_ssh_config 'IgnoreUnknown UseKeychain'
add_ssh_config 'UseKeychain yes'

unlock_bitwarden_vault

if ! items="$(bw list items)"; then
	fatal 'failed to list Bitwarden items'
fi

if ! hostname="$(hostname -s)"; then
	fatal 'failed to get system hostname'
fi

log "using hostname \"$hostname\""

if ! authorized_key_items="$(
	jq --exit-status --raw-output --arg hostname "$hostname" '
		def trim: gsub("^\\s+|\\s+$"; "");
		[
			.[]
			| select(.type == 5)
			| select(
				[
					.fields[]?
					| select(.name == "Authorized hosts")
					| (.value // "")
					| split(",")[]
					| trim
				] | index($hostname)
			)
			| {item_name: .name, public_key: ((.sshKey.publicKey // "") | trim)}
		]
		| unique_by(.public_key)
		| map([.item_name, .public_key] | @tsv)
		| if length == 0 then "" else .[] end
	' <<<"$items"
)"; then
	fatal "failed to read SSH keys authorized for \"$hostname\""
fi

tmp_authorized_keys="$(mktemp "$HOME"/.ssh/authorized_keys.XXXXXX)"
trap 'rm -f "$tmp_authorized_keys"' EXIT
printf '%s\n' '# Managed by dotfiles lib/ssh.' >"$tmp_authorized_keys"

if [ -n "$authorized_key_items" ]; then
	while IFS=$'\t' read -r item_name public_key; do
		if ! printf '%s\n' "$public_key" | ssh-keygen -lf /dev/stdin >/dev/null 2>&1; then
			fatal "Bitwarden SSH key item \"$item_name\" has an invalid public key"
		fi
		printf '%s\n' "$public_key" >>"$tmp_authorized_keys"
	done <<<"$authorized_key_items"
fi

install --mode=600 "$tmp_authorized_keys" "$HOME"/.ssh/authorized_keys

log_end
