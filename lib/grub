#!/usr/bin/env bash

# shellcheck source=./lib/helpers
source "${BASH_SOURCE[0]%/*}/helpers"

log() {
	log_with_component grub "$@"
}

# shellcheck disable=SC2119
request_sudo

log_start 'setting up grub'

log_start 'disabling generation of recovery options'
request_sudo sed -i 's|#GRUB_DISABLE_RECOVERY="true"|GRUB_DISABLE_RECOVERY="true"|' /etc/default/grub
log_end

log_start 'enabling os-prober to detect other operating systems'
request_sudo sed -i 's|#GRUB_DISABLE_OS_PROBER=false|GRUB_DISABLE_OS_PROBER=false|' /etc/default/grub
log_end

grub_theme_dir=/boot/grub/themes/adamvig
grub_font_output_path="$grub_theme_dir"/opensans-regular.pf2
grub_theme_variable="GRUB_THEME=$grub_theme_dir/theme.txt"
log_start 'removing theme and font, disabling theme'
request_sudo rm -rf "$grub_theme_dir" "$grub_font_output_path"
if ! request_sudo sed -i "\|$grub_theme_variable|d" /etc/default/grub; then
	fatal 'failed to disable theme'
fi
log_end

grub_memtest_variable="GRUB_DISABLE_MEMTEST=true"
if ! grep --quiet "$grub_memtest_variable" /etc/default/grub; then
	log_start 'disabling generation of memtest options'
	if ! echo "$grub_memtest_variable" | request_sudo tee --append /etc/default/grub >/dev/null; then
		fatal 'failed to disable generation of memtest options'
	fi
	log_end
fi

log_start 'skipping menu timeout for one-time boot entries'
# Sorts after 30_os-prober, whose dual-boot timeout this overrides
request_sudo install --owner=root --group=root --mode=755 \
	"$script_dir"/../config/grub-boot-once \
	/etc/grub.d/41_dotfiles-boot-once
log_end

if ! is_laptop; then
	log_start 'keeping the monitor connected while the KVM is switched away'
	connector_paths=()
	for status_path in /sys/class/drm/card*-*/status; do
		if [ "$(<"$status_path")" = connected ]; then
			connector_paths+=("${status_path%/status}")
		fi
	done

	grub_display_config=/etc/default/grub.d/dotfiles-display.cfg
	edid_tmp="$(mktemp)"
	if [ "${#connector_paths[@]}" -ne 1 ]; then
		warn "expected one connected monitor but found ${#connector_paths[@]}, skipping"
	elif [ -f "$grub_display_config" ]; then
		connector="${connector_paths[0]#*/card*-}"
		# sysfs reports the forced copy, so read the monitor's base EDID block, which identifies it, over DP AUX
		# The connector's `ddc` link is the GPU's legacy DDC bus, which DisplayPort monitors don't answer on
		aux_adapter_paths=("${connector_paths[0]}"/i2c-*)
		if ! edid_hex="$(request_sudo i2ctransfer -y "${aux_adapter_paths[0]##*i2c-}" w1@0x50 0x00 r128@0x50)"; then
			warn 'failed to read the monitor over DP AUX, keeping the saved EDID'
		else
			edid_hex="${edid_hex//0x/\\x}"
			printf '%b' "${edid_hex// /}" >"$edid_tmp"
			if ! cmp --quiet --bytes=128 "$edid_tmp" /usr/lib/firmware/edid/dotfiles-"$connector".bin; then
				read -r -p "$(make_prompt 'The connected monitor differs from the saved one. Stop forcing the saved one? [y/N]') " replace_monitor
				if [ "$replace_monitor" = y ]; then
					request_sudo rm "$grub_display_config"
					warn 'reboot, then re-run this to save the connected monitor'
				fi
			fi
		fi
	elif ! cat "${connector_paths[0]}"/edid >"$edid_tmp" || ! [ -s "$edid_tmp" ]; then
		warn "failed to read the monitor's EDID, skipping"
	else
		connector="${connector_paths[0]#*/card*-}"
		edid_firmware="edid/dotfiles-$connector.bin"
		request_sudo install -D --owner=root --group=root --mode=644 "$edid_tmp" /usr/lib/firmware/"$edid_firmware"

		grub_display_tmp="$(mktemp)"
		echo "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT video=$connector:e drm.edid_firmware=$connector:$edid_firmware\"" >"$grub_display_tmp"
		request_sudo install --owner=root --group=root --mode=644 "$grub_display_tmp" "$grub_display_config"
		rm "$grub_display_tmp"
	fi
	rm "$edid_tmp"
	log_end
fi

log_start 're-generating Grub configuration'
request_sudo grub-mkconfig -o /boot/grub/grub.cfg
# Match the mode grub-mkconfig gives a new grub.cfg; it keeps an existing file's mode, so older installs vary
request_sudo chmod 600 /boot/grub/grub.cfg
log_end

log_end
