#!/usr/bin/env bash

# Initialize a system user that can be used for remote management of the system.
# This is intended for use via SSH from another host on the same network. For example, Home Assistant could be
# configured to run the command `ssh remote-management@HOST suspend` to suspend the computer.
#
# This system is designed with security in mind, but undoubtedly has vulnerabilities anyways.
# - Separate user with no password, no group membership, and an isolated home directory to limit access to the system.
# - SSH authorized_keys entry is configured to restrict access to many features of SSH, including allocating a TTY,
#   and to only accept connections from a single IP address.
# - Login shell limits user to executing a single command.
# - The user's home directory and everything in it are owned by root, so the user can't modify its SSH
#   authorized_keys file, login shell, or ,remotecontrol script.
#
# The remote host must have an SSH key without a passphrase. The remote host's public key must be inserted in
# /usr/local/share/remote-management/.ssh/authorized_keys in place of "<insert key here>".

# shellcheck source=./lib/helpers
source "${BASH_SOURCE[0]%/*}/helpers"

log() {
	log_with_component remote-management "$@"
}

! is_laptop || exit 0

request_sudo

log_start 'initializing remote management user'

readonly remote_management_username='remote-management'
readonly remote_management_user_home_path=/usr/local/share/"$remote_management_username"
readonly remote_management_shell_path="$remote_management_user_home_path"/remote-management-shell
readonly authorized_keys_path="$remote_management_user_home_path"/.ssh/authorized_keys

# To delete the user, run: sudo deluser --system remote-management && sudo rm -r /usr/local/share/remote-management
if ! id "$remote_management_username" &>/dev/null; then
	log_start 'creating remote management user'
	request_sudo adduser --system --disabled-password --home "$remote_management_user_home_path" --shell "$remote_management_shell_path" "$remote_management_username"
	request_sudo passwd --lock "$remote_management_username"
	log_end

	log_start 'creating template SSH authorized keys file'
	request_sudo mkdir -p "$remote_management_user_home_path"/.ssh
	# Apply restrictions except for TTY access
	# shellcheck disable=SC2016
	echo 'restrict <insert key here>' |
		request_sudo tee "$authorized_keys_path" >/dev/null
	log_end
fi

if ! request_sudo grep --quiet 'from=' "$authorized_keys_path"; then
	log_start 'restricting SSH access to a single IP address'
	read -r -p "$(make_prompt 'IP address of the host allowed to connect (e.g. Home Assistant):') " allowed_ip
	if [ -n "$allowed_ip" ]; then
		request_sudo sed -i "s|^restrict |restrict,from=\"$allowed_ip\" |" "$authorized_keys_path"
	else
		warn 'must provide an IP address, skipping restriction'
	fi
	log_end
fi

log_start 'making remote management files root-owned'
request_sudo chown root:root "$remote_management_user_home_path" "$remote_management_user_home_path"/.ssh "$authorized_keys_path"
request_sudo chmod 755 "$remote_management_user_home_path" "$remote_management_user_home_path"/.ssh
request_sudo chmod 644 "$authorized_keys_path"
log_end

log_start 'configuring sudoers to allow non-interactive power control'
sudoers_tmp="$(mktemp)"
echo "# Allow for non-interactive execution of system power commands.

$remote_management_username ALL=NOPASSWD: /usr/bin/systemctl poweroff,/usr/bin/systemctl suspend,/usr/bin/systemctl reboot,/usr/sbin/grub-reboot,/usr/bin/cat /boot/grub/grub.cfg" >"$sudoers_tmp"
visudo --check --file "$sudoers_tmp" >/dev/null || fatal 'generated sudoers file is invalid'
request_sudo install --owner=root --group=root --mode=440 "$sudoers_tmp" /etc/sudoers.d/remote-management
rm "$sudoers_tmp"
log_end

log_start 'setting up remote management shell'
echo "#!/bin/bash
if [[ \"\$1\" != '-c' || -z \"\$2\" ]]; then
    echo >&2 \"Expected: '-c <remotecontrol argument>', received: '\$@'\"
    exit 1
fi

exec $remote_management_user_home_path/,remotecontrol \"\$2\"
" | request_sudo tee "$remote_management_shell_path" >/dev/null
request_sudo chmod 755 "$remote_management_shell_path"
# Copy instead of symlinking because symlink yields "cannot execute: Permission denied"
request_sudo install --owner=root --group=root --mode=755 "$script_dir"/../bin/,remotecontrol "$remote_management_user_home_path"/,remotecontrol
log_end

log_start 'enabling wake-on-LAN for wired connections'
# Takes effect when a connection next activates, e.g. on the next boot
request_sudo install --owner=root --group=root --mode=644 \
	"$script_dir"/../config/network-manager-wake-on-lan.conf \
	/etc/NetworkManager/conf.d/dotfiles-wake-on-lan.conf
log_end

log_end
