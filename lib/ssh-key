#!/usr/bin/env bash

# shellcheck source=./lib/helpers
source "${BASH_SOURCE[0]%/*}/helpers"

log() {
	log_with_component ssh-key "$@"
}

log_start 'setting up SSH key'

mkdir --parents "$HOME"/.ssh
chmod 700 "$HOME"/.ssh

readonly ssh_private_key_path="$HOME"/.ssh/id_ed25519
readonly ssh_public_key_path="$ssh_private_key_path".pub
readonly item_notes='- The "Private key" field has no passphrase, install the attached passphrase-protected key file instead.
- "Authorized hosts" is a comma-separated list of the hostnames that this key should be able to access.'

if { [ -e "$ssh_private_key_path" ] && [ ! -e "$ssh_public_key_path" ]; } ||
	{ [ ! -e "$ssh_private_key_path" ] && [ -e "$ssh_public_key_path" ]; }; then
	fatal 'found an incomplete id_ed25519 key pair'
fi

if [ -f "$ssh_private_key_path" ] && [ -f "$ssh_public_key_path" ]; then
	log 'found existing SSH key, skipping acquisition'
else
	unlock_bitwarden_vault

	if ! hostname="$(hostname -s)"; then
		fatal 'failed to get system hostname'
	fi

	log "using hostname \"$hostname\""

	if ! items="$(bw list items)"; then
		fatal 'failed to list Bitwarden items'
	fi

	item_name="SSH Key: $hostname"
	if ! item="$(
		jq --arg item_name "$item_name" '
			[.[] | select(.type == 5 and .name == $item_name)]
			| if length > 1 then error("multiple matches") else .[0] // empty end
		' <<<"$items"
	)"; then
		fatal "found multiple SSH keys named \"$item_name\""
	fi

	if [ -n "$item" ]; then
		log_start 'installing existing key'
		item_id="$(jq --raw-output '.id' <<<"$item")"
		stored_public_key="$(jq --raw-output '.sshKey.publicKey' <<<"$item")"

		tmp_dir="$(mktemp --directory)"
		trap 'rm -rf "$tmp_dir"' EXIT
		tmp_private_key_path="$tmp_dir"/id_ed25519
		if ! bw get attachment id_ed25519 --itemid "$item_id" --output "$tmp_private_key_path" >/dev/null; then
			fatal 'failed to download passphrase-protected id_ed25519 attachment'
		fi

		install --mode 600 "$tmp_private_key_path" "$ssh_private_key_path"
		echo "$stored_public_key" >"$ssh_public_key_path"
		chmod 644 "$ssh_public_key_path"
		rm -rf "$tmp_dir"
		trap - EXIT
		log_end
	else
		log_start 'creating new key'
		read -r -p "$(make_prompt 'Authorized hosts (comma-separated, optional):') " authorized_hosts
		if ! passphrase="$(bw generate --uppercase --lowercase --number --length=45)"; then
			fatal 'failed to generate SSH key passphrase'
		fi
		# `-a 64` quadruples OpenSSH’s default bcrypt KDF rounds, strengthening against offline passphrase attacks
		ssh-keygen -q -t ed25519 -a 64 -N "$passphrase" -C "$USER@$hostname" -f "$ssh_private_key_path"

		tmp_dir="$(mktemp --directory)"
		trap 'rm -rf "$tmp_dir"' EXIT
		tmp_private_key_path="$tmp_dir"/id_ed25519
		cp "$ssh_private_key_path" "$tmp_private_key_path"
		ssh-keygen -q -p -P "$passphrase" -N '' -f "$tmp_private_key_path"
		fingerprint="$(ssh-keygen -lf "$ssh_public_key_path" | awk '{print $2}')"

		if ! item_id="$(
			bw get template item |
				jq \
					--arg item_name "$item_name" \
					--arg passphrase "$passphrase" \
					--arg created "$(date '+%B %-d, %Y')" \
					--arg authorized_hosts "$authorized_hosts" \
					--arg notes "$item_notes" \
					--arg fingerprint "$fingerprint" \
					--rawfile private_key "$tmp_private_key_path" \
					--rawfile public_key "$ssh_public_key_path" \
					'.name = $item_name
					| .type = 5
					| .notes = $notes
					| .sshKey = {
						privateKey: $private_key,
						publicKey: $public_key,
						keyFingerprint: $fingerprint
					}
					| .fields = [
						{name: "Passphrase", value: $passphrase, type: 1},
						{name: "Authorized hosts", value: $authorized_hosts, type: 0},
						{name: "Created", value: $created, type: 0}
					]' |
				bw encode |
				bw create item |
				jq --exit-status --raw-output '.id'
		)"; then
			warn 'failed to save SSH key to Bitwarden; back up the key manually'
		elif ! bw create attachment --file "$ssh_private_key_path" --itemid "$item_id" >/dev/null; then
			warn 'failed to attach the passphrase-protected private key; attach it manually as id_ed25519'
		fi

		rm -rf "$tmp_dir"
		trap - EXIT
		bw sync
		log_end
	fi
fi

if is_macos; then
	log_start 'loading key into ssh-agent (passphrase cached in Keychain)'
	ssh-add --apple-use-keychain "$ssh_private_key_path"
	log_end
fi

log_end
